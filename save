#!/usr/bin/env bash

set -eEuo pipefail

if [[ "${#}" -lt 1 || -z "${1}" ]]; then
	>&2 echo 'FATAL: problem ID string not supplied'
	exit 1
fi

PROB_ID="${1}"
mkdir "${PROB_ID}"

>"${PROB_ID}/README.md" cat <<EOF
# [$PROB_ID](https://leetcode.com/problems/$PROB_ID/)
EOF

read -r -n1 -s -p 'Copy solution to clipboard, then press any key here...'
>"${PROB_ID}/${PROB_ID}.py" pbpaste

git add "${PROB_ID}/"
git commit

git pull --rebase
git push
